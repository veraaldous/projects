[Unit]
Description=WildFly application server lab
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/wildfly

[Service]
Type=simple
User=wildfly
Group=wildfly
WorkingDirectory=/opt/wildfly
EnvironmentFile=/etc/sysconfig/wildfly
ExecStart=/opt/wildfly/bin/standalone.sh -b 127.0.0.1 -bmanagement 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
